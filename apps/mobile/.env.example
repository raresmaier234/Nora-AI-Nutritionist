# Base URL of the FastAPI backend. No trailing slash, and no /api/v1 suffix —
# the API client (src/services/api/config.ts) appends the versioned prefix centrally.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are readable by
# anyone with the compiled app — never put secrets here, only the public API base URL.
#
# iOS Simulator:    http://127.0.0.1:8000   (this is also the default if the var is unset)
# Physical iPhone:  http://<your-Mac-LAN-IP>:8000   (same Wi-Fi; backend must bind 0.0.0.0 —
#                    see nora-ai-nutrition-api/README.md)
# Android Emulator: http://10.0.2.2:8000    (documented host-loopback alias)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
