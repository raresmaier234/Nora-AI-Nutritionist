# Base URL of the FastAPI backend. No trailing slash, and no /api/v1 suffix —
# the API client (src/services/api/config.ts) appends the versioned prefix centrally.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are readable by
# anyone with the compiled app — never put secrets here, only the public API base URL.
#
# iOS Simulator:    http://127.0.0.1:8000   (this is also the default if the var is unset)
# Physical iPhone:  http://<your-Mac-LAN-IP>:8000   (same Wi-Fi; backend must bind 0.0.0.0 —
#                    see nora-ai-nutrition-api/README.md)
# Android Emulator: http://10.0.2.2:8000    (documented host-loopback alias)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase Auth, which runs sign-in with Google and Apple (Supabase is used for sign-in only; app
# data stays in our API). Use the *development* Supabase project locally. Both values come from
# the Supabase dashboard (Project Settings → Data API for the URL, → API Keys for the key):
#
# EXPO_PUBLIC_SUPABASE_URL              the project URL, e.g. https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY  the *publishable* key, sb_publishable_… — public by
#                                       design. NEVER the secret key (sb_secret_…): that one
#                                       belongs to the API only.
#
# Left empty, the app still starts, but the sign-in screen says sign-in is not configured.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
