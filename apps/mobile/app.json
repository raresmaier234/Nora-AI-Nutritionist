{
  "expo": {
    "name": "nora-ai-nutrition",
    "slug": "nora-ai-nutrition",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "noraainutrition",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nora needs camera access to scan barcodes and take photos of your food.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b090adf-b317-49fd-b80a-1037073cc3ed"
      }
    },
    "owner": "raresm123s-team"
  }
}
